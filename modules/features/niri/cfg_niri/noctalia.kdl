layout {

    focus-ring {
        active-color   "#67e4a6"
        inactive-color "#1e1f1e"
        urgent-color   "#fd4663"
    }

    border {
        active-color   "#67e4a6"
        inactive-color "#1e1f1e"
        urgent-color   "#fd4663"
    }


    tab-indicator {
        active-color   "#67e4a6"
        inactive-color "#14854d"
        urgent-color   "#fd4663"
    }

    insert-hint {
        color "#67e4a680"
    }
}

recent-windows {
    highlight {
        active-color "#67e4a6"
        urgent-color "#fd4663"
    }
}
