layout {

    focus-ring {
        active-color   "#4d6fff"
        inactive-color "#030e3a"
        urgent-color   "#fd4663"
    }

    border {
        active-color   "#4d6fff"
        inactive-color "#030e3a"
        urgent-color   "#fd4663"
    }

    shadow {
        color "#030e3a70"
    }

    tab-indicator {
        active-color   "#4d6fff"
        inactive-color "#001d9a"
        urgent-color   "#fd4663"
    }

    insert-hint {
        color "#4d6fff80"
    }
}

recent-windows {
    highlight {
        active-color "#4d6fff"
        urgent-color "#fd4663"
    }
}
