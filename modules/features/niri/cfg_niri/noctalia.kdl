layout {

    focus-ring {
        active-color   "#e4676b"
        inactive-color "#291415"
        urgent-color   "#c4282d"
    }

    border {
        active-color   "#e4676b"
        inactive-color "#291415"
        urgent-color   "#c4282d"
    }


    tab-indicator {
        active-color   "#e4676b"
        inactive-color "#851417"
        urgent-color   "#c4282d"
    }

    insert-hint {
        color "#e4676b80"
    }
}

recent-windows {
    highlight {
        active-color "#e4676b"
        urgent-color "#c4282d"
    }
}
