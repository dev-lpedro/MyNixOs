{
    "files.autoSave": "afterDelay",
    "editor.wordWrap": "bounded",
    
    // Desativa sugestões automáticas inline do Copilot
    "editor.inlineSuggest.enabled": false,
    "github.copilot.editor.enableAutoCompletions": false,

    // Tema do Noctalia Shell e fonte do terminal com ícones Nerd Fonts
    //"workbench.colorTheme": "NoctaliaTheme",
    "terminal.integrated.fontFamily": "'JetBrainsMono Nerd Font', 'Symbols Nerd Font', monospace",

    // Configurações do Servidor de Linguagem Nix (nixd + alejandra)
    "nix.enableLanguageServer": true,
    "nix.serverPath": "nixd",
    "nix.serverSettings": {
        "nixd": {
            "nixpkgs": {
                "expr": "import <nixpkgs> { }"
            },
            "formatting": {
                "command": [ "alejandra" ]
            },
            "options": {
                "nixos": {
                    "expr": "(builtins.getFlake \"/home/leonardo/MyNixOs\").nixosConfigurations.fakeNixOs.options"
                },
                "home-manager": {
                    "expr": "(builtins.getFlake \"/home/leonardo/MyNixOs\").nixosConfigurations.fakeNixOs.options.home-manager.users.type.getSubOptions []"
                }
            }
        }
    },
    "git.autofetch": true,
    "roo-cline.debug": false,
    "roo-cline.allowedCommands": [
        "git log",
        "git diff",
        "git show"
    ],
    "roo-cline.deniedCommands": [],
    "explorer.confirmDelete": false,
    "js/ts.updateImportsOnFileMove.enabled": "always",
    "workbench.editorAssociations": {
        "{git,gitlens,chat-editing-snapshot-text-model,copilot,git-graph,git-graph-3}:/**/*.qrc": "default",
        "*.qrc": "qt-core.qrcEditor"
    },
    "qt-core.additionalQtPaths": [
        {
            "name": "Qt-6.11.2-linux-g++-x86_64_from_PATH",
            "path": "/run/current-system/sw/bin/qtpaths"
        }
    ],

    // Configuração do LSP do Quickshell / QML (Requer extensão genérica de LSP)
    "languageServers": {
        "qml": {
            "command": "qml-language-server",
            "filetypes": ["qml"]
        }
    },
    "qt-qml.doNotAskForQmllsDownload": true,
    "explorer.confirmPasteNative": false,
    "git.enableSmartCommit": true,
    "git.confirmSync": false,
    "redhat.telemetry.enabled": true
}